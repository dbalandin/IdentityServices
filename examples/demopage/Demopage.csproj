<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Demopage</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- OIDC authorization code flow (+PKCE) против Keycloak realm rulink -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- единый источник хелперов/трансформера клеймов — из examples/demo-api (контракт jwt-claims.md §7) -->
    <Compile Include="../demo-api/KeycloakClaims.cs" Link="Shared/KeycloakClaims.cs" />
    <Compile Include="../demo-api/RealmRolesTransformer.cs" Link="Shared/RealmRolesTransformer.cs" />
  </ItemGroup>

</Project>
