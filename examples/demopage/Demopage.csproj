<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Demopage</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- тесты — отдельный проект ниже по дереву; исключаем из web-приложения (и из Content/None:
         иначе web-SDK собирает tests/**/bin/**/*.json как контент и Mvc.Testing копирует их рекурсивно) -->
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Аутентификация — библиотека IdentityService: OIDC-логин через Keycloak (cookie + authorization
         code + PKCE), realm-роли и хелперы клеймов. NuGet-пакета пока нет — ProjectReference на соседний
         каталог (тот же путь, что в examples/example.slnx). Для docker-сборки библиотека подключается
         именованным контекстом — см. Dockerfile -->
    <ProjectReference Include="..\..\..\IdentityService\IdentityService\IdentityService.csproj" />
  </ItemGroup>

</Project>
