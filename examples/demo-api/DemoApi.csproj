<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DemoApi</RootNamespace>
    <!-- адрес задаётся в appsettings.json (Urls=http://127.0.0.1:10010):
         demo-api 10010, keycloak 10020, портал 10030, demopage 10040 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- тесты — отдельный проект ниже по дереву; исключаем из web-приложения (и из Content/None:
         иначе web-SDK собирает tests/**/bin/**/*.json как контент и Mvc.Testing копирует их рекурсивно) -->
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Аутентификация Keycloak (JWT Bearer, realm-роли, хелперы клеймов) — библиотека IdentityService:
        docs/contracts/jwt-claims.md §7 реализованы в ней. NuGet-пакета пока нет — ProjectReference на соседний
         каталог (тот же путь, что в examples/example.slnx). Для docker-сборки библиотека подключается
         именованным контекстом — см. Dockerfile -->
    <ProjectReference Include="..\..\..\IdentityService\IdentityService\IdentityService.csproj" />
  </ItemGroup>

</Project>
